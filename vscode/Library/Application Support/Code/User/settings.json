{
  "editor.autoClosingBrackets": "always",
  "editor.autoIndent": "keep",
  "editor.bracketPairColorization.enabled": false,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.foldingHighlight": false,
  "editor.fontSize": 14,
  "editor.formatOnPaste": true,
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": false,
  "editor.matchBrackets": "near",
  "editor.renderLineHighlight": "all",
  "editor.rulers": [
    120
  ],
  "editor.scrollBeyondLastLine": false,
  // Theme color changes
  "editor.semanticTokenColorCustomizations": {
    "[One Dark Pro]": {
      "rules": {
        "class": "#D19A66",
        "function.defaultLibrary": {
          "fontStyle": "italic",
          "foreground": "#E5C07B"
        },
        "variable.readonly": "#D19A66"
      }
    }
  },
  "editor.tokenColorCustomizations": {
    "[One Dark Pro]": {
      "textMateRules": [
        {
          "scope": [
            "punctuation.definition.directive.prefix.vue-html",
            "entity.name.directive.vue-html"
          ],
          "settings": {
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "entity.name.section.vue"
          ],
          "settings": {
            "fontStyle": "bold",
            "foreground": "#E06C75"
          }
        },
        {
          "scope": [
            "variable.language.this.php",
            "meta.object-literal.key.js",
            "variable.other.object.property.js",
            "variable.other.object.property.ts",
            "meta.object-literal.key.js",
            "meta.function.closure.use.php"
          ],
          "settings": {
            "foreground": "#E06C75"
          }
        },
        {
          "scope": [
            "variable.parameter",
            "keyword.operator.logical",
            "keyword.operator.comparison",
            "keyword.operator.relational",
            "keyword.operator.ternary",
            "punctuation.definition.template-expression.begin.js",
            "punctuation.definition.template-expression.end.js",
            "punctuation.section.function.begin.bracket.round.css",
            "punctuation.section.function.end.bracket.round.css",
            "keyword.operator.assignment",
            "keyword.other.type.php",
            "entity.name.type.namespace.php",
            "keyword.operator.class.php",
            "variable.other.object.ts",
            "punctuation.definition.entity.css",
            "keyword.operator.comparison.php",
            "keyword.operator.logical.php",
            "keyword.operator.arithmetic.php",
            "keyword.operator.arithmetic.js"
          ],
          "settings": {
            "foreground": "#ABB2BF"
          }
        },
        {
          "scope": [
            "punctuation.attribute-shorthand.bind.html.vue",
            "entity.other.attribute-name.class.css",
            "keyword.control.conditional.vue"
          ],
          "settings": {
            "foreground": "#E5C07B"
          }
        },
        {
          "scope": [
            "entity.other.attribute-name.html.vue",
            "entity.other.attribute-name.html",
            "punctuation.attribute-shorthand.event.html.vue",
            "variable.other.directive.argument.vue-html",
            "keyword.operator.event-handler-shorthand.vue-html",
            "keyword.operator.slot-shorthand.vue-html",
            "keyword.operator.binding-shorthand.vue-html",
            "entity.other.block-attribute-name.vue"
          ],
          "settings": {
            "fontStyle": "italic",
            "foreground": "#E5C07B"
          }
        },
        {
          "scope": [
            "entity.other.attribute-name.vue-html"
          ],
          "settings": {
            "fontStyle": "italic",
            "foreground": "#D19A66"
          }
        },
        {
          "scope": [
            "variable.other.object.js",
            "variable.other.object.ts",
            "keyword.other.unit",
            "variable.other.readwrite.js",
            "variable.other.readwrite.alias.js",
            "constant.other.php"
          ],
          "settings": {
            "foreground": "#D19A66"
          }
        },
        {
          "scope": [
            "storage.type.function.arrow",
            "punctuation.section.array"
          ],
          "settings": {
            "foreground": "#7F848E"
          }
        },
        {
          "scope": [
            "punctuation.section.embedded.begin.php"
          ],
          "settings": {
            "fontStyle": "italic",
            "foreground": "#7F848E"
          }
        },
        {
          "scope": [
            "support.function.construct.php",
            "constant.language.boolean.false.js",
            "constant.language.boolean.true.js",
            "constant.language.php",
            "variable.language.this.js",
            "punctuation.definition.directive.prefix.vue-html",
            "entity.name.directive.vue-html"
          ],
          "settings": {
            "foreground": "#C678DD"
          }
        },
        {
          "scope": "entity.other.attribute-name.pseudo-class.css",
          "settings": {
            "foreground": "#FFFFFF"
          }
        },
        {
          "scope": [
            "support.type.property-name.css"
          ],
          "settings": {
            "foreground": "#56B6C2"
          }
        },
        {
          "scope": [
            "support.function.constructor.php"
          ],
          "settings": {
            "foreground": "#61AFEF"
          }
        },
        {
          "scope": [
            "punctuation.separator.key-value.html.vue",
            "punctuation.definition.string.begin.html.vue",
            "punctuation.definition.string.end.html.vue",
            "punctuation.separator.key-value.html",
            "string.regexp.single-quoted.php",
            "constant.character.escape.php"
          ],
          "settings": {
            "foreground": "#98C379"
          }
        },
        {
          "scope": [
            "keyword.control.import.js",
            "keyword.control.from.js",
            "keyword.control.export.js",
            "keyword.control.default.js",
            "storage.type.js"
          ],
          "settings": {
            "fontStyle": "italic"
          }
        }
      ]
    }
  },
  "eslint.codeAction.disableRuleComment": {
    "enable": false
  },
  "eslint.codeActionsOnSave.mode": "problems",
  "eslint.format.enable": true,
  "eslint.quiet": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "html.format.wrapAttributes": "force-expand-multiline",
  "indentRainbow.indicatorStyle": "light",
  "indentRainbow.lightIndicatorStyleLineWidth": 2,
  "scm.diffDecorationsGutterPattern": {
    "modified": false
