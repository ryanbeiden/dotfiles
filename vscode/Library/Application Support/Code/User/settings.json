  "workbench.colorTheme": "One Dark Pro",
  "workbench.iconTheme": "material-icon-theme",
  "todohighlight.isEnable": true,
  "search.followSymlinks": false,
  "workbench.startupEditor": "none",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "github.copilot.nextEditSuggestions.enabled": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[javascriptreact]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[json]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[svelte]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "[html]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
  },
  "[javascript]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "js/ts.inlayHints.parameterNames.enabled": "all",
  "js/ts.inlayHints.variableTypes.enabled": true,
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "chat.checkpoints.showFileChanges": true,
  "editor.inlineSuggest.syntaxHighlightingEnabled": false,
  "editor.inlineSuggest.edits.showCollapsed": true,
  "editor.indentSize": "tabSize",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "github.copilot.chat.reviewSelection.instructions": [],
  "chat.mcp.serverSampling": {
    "coach-builder/.vscode/mcp.json: laravel-boost": {
      "allowedModels": [
        "copilot/claude-sonnet-4",
        "copilot/gpt-4o",
        "copilot/o1-preview"
      ]
    }
  },
  "accessibility.verbosity.panelChat": false,
  "workbench.panel.showLabels": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "svelte.enable-ts-plugin": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "php": false,
    "typescriptreact": false
  },
  "git.openRepositoryInParentFolders": "never",
  "intelephense.environment.includePaths": [
    "_ide_helper.php",
    "storage/framework/testing"
  ],
  "intelephense.diagnostics.argumentCount": "declared",
  "files.exclude": {
    "**/_ide_helper.php": false
  },
}
