[user]
    name = Ryan Beiden
    email = ryanbeiden@pm.me
[core]
    editor = nvim
[color]
    ui = auto

[color "branch"]
    current = "#cba6f7 bold"    # mauve
    local = "#a6e3a1"           # green
    remote = "#89b4fa"          # blue
    plain = "#cdd6f4"           # text
    upstream = "#94e2d5"        # teal

[color "diff"]
    meta = "#cba6f7 bold"       # mauve
    old = "#f38ba8"             # red
    new = "#a6e3a1"             # green
    frag = "#b4befe bold"       # lavender
    commit = "#f9e2af bold"     # yellow
    whitespace = "#f38ba8 reverse"  # red
    context = "#cdd6f4"         # text
    func = "#89dceb"            # sky

[color "status"]
    added = "#a6e3a1"           # green
    updated = "#f9e2af"         # yellow
    changed = "#f9e2af"         # yellow
    untracked = "#f38ba8"       # red
    branch = "#74c7ec"          # sapphire
    header = "#9399b2"          # overlay2
    unmerged = "#fab387 bold"   # peach
    localBranch = "#a6e3a1"     # green
    remoteBranch = "#89b4fa"    # blue

[color "grep"]
    filename = "#89b4fa"        # blue
    linenumber = "#f9e2af"      # yellow
    match = "#f38ba8 bold"      # red
    context = "#6c7086"         # overlay0

[color "decorate"]
    branch = "#a6e3a1"          # green
    remoteBranch = "#89b4fa"    # blue
    tag = "#f9e2af bold"        # yellow
    HEAD = "#cba6f7 bold"       # mauve

[color "blame"]
    highlightRecent = "#f38ba8,1 day ago,#fab387,1 week ago,#f9e2af,1 month ago,#a6e3a1"
    # red (today) -> peach (1wk) -> yellow (1mo) -> green (older)

[color "interactive"]
    prompt = "#89dceb bold"     # sky
    header = "#9399b2"          # overlay2
    help = "#6c7086"            # overlay0
  error = "#f38ba8 bold"      # red

